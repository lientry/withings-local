{
  "domain": "withings_local",
  "name": "Withings Local (Bluetooth)",
  "bluetooth": [
    {
      "connectable": true,
      "manufacturer_id": 1023
    },
    {
      "connectable": true,
      "local_name": "Body Smart*"
    }
  ],
  "codeowners": ["@pierosavi"],
  "config_flow": true,
